{
    "name": "streaming-platform-backend",
    "version": "2.0.0",
    "description": "High-scale media streaming backend — refactored for 10M+ users",
    "main": "src/app.js",
    "scripts": {
        "start": "node src/app.js",
        "start:web": "node src/app.js",
        "start:worker": "node src/worker.js",
