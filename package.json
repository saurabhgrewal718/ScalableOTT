    },
    "dependencies": {
        "@bull-board/api": "^7.0.0",
        "@bull-board/express": "^7.0.0",
        "bullmq": "^5.4.0",
        "dotenv": "^17.4.2",
        "express": "^4.18.2",
        "ioredis": "^5.3.2",
        "zod": "^3.22.4"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}