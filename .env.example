# App Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Heartbeat Buffer Configuration
HEARTBEAT_FLUSH_INTERVAL_MS=10000
HEARTBEAT_CIRCUIT_RESET_MS=60000
HEARTBEAT_MAX_BUFFER=200000

# Worker Configuration
ANALYTICS_CONCURRENCY=20
HEARTBEAT_CONCURRENCY=1

# Dashboard Configuration
DASHBOARD_PATH=/admin/queues
